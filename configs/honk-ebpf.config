# Apply after the corresponding ZN-M2 base configuration and before defconfig.
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
# honk's optional UDP receive-trace fallback attaches fentry/fexit programs on
# __skb_recv_udp. Without ftrace it degrades ("kernel UDP trace attach
# unavailable, ipv4_unavailable=true ipv6_unavailable=true") and the engine
# loses the receive-priority metadata path for UDP sockets.
CONFIG_KERNEL_FUNCTION_TRACER=y
CONFIG_KERNEL_DYNAMIC_FTRACE=y
CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_kmod-sched-bpf=y
# honk attaches TCX links and pins maps on bpffs; there is no clsact qdisc to
# inspect. bpftool is the only way an operator can read programs, maps and
# links back out of the kernel on a deployed device.
CONFIG_PACKAGE_bpftool=y
# CONFIG_PACKAGE_luci-app-homeproxy is not set
# CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn is not set
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_sing-box-tiny is not set
