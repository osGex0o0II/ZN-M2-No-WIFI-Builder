# Configuration for honk-core, installed as /etc/honk/config.dae.
#
# This file is a working skeleton: add nodes or subscriptions and routing rules
# in doona before enabling proxy traffic. Until then every connection is routed
# directly until proxy nodes and policy are configured.
#
# Interfaces: br-lan is the OpenWrt LAN bridge on this device; `auto` follows
# the interface of the IPv4 default route.
#
# Open http://<router LAN IP>:9527/ from the LAN. Use the IP address: honk
# refuses host names such as openwrt.lan. The page is plain HTTP, like LuCI, and
# the bundled fw4 input rule limits port 9527 to br-lan and loopback. To keep the dashboard on
# the router only, change listen to '127.0.0.1:9527' and reach it with
# ssh -L 9527:127.0.0.1:9527 root@<router>.
#
# The first visit creates the administrator. Credentials are stored under
# data_dir in state/honk.db, not in this file.

global {
    wan_interface: auto
    lan_interface: br-lan
    # The upstream default is info; warning keeps the syslog volume low on a
    # 200 MB device without hiding startup failures.
    log_level: warning
    dial_mode: domain++
    data_dir: '/etc/honk/data'
    # Empty: log to stdout, which procd forwards to syslog/logread.
    log_file: ''
    tcp_check_url: 'https://www.gstatic.com/generate_204'
    tcp_check_http_method: HEAD
    check_interval: 300s
    # Used for the downloader's own lookups (geodata, subscriptions). 1.1.1.1
    # resolves here, but honk's own queries through it fail on this network with
    # "resolution_failed", so the geodata update never starts. 223.5.5.5 is the
    # resolver the config already trusts for dns.upstream.local.
    bootstrap_resolver: '223.5.5.5:53'
    # NFQUEUE 320 exists to hold ambiguous LAN UDP first packets. On this
    # kernel it starves dnsmasq: with it enabled every DNS query that has to go
    # out through the WAN stalls (verified on 6.12.112, beta.6), so the whole
    # LAN loses name resolution. honk keeps working without it.
    nfqueue_enable: false
}

dns {
    upstream {
        # honk's own lookups go to a public resolver, not to dnsmasq. Pointing
        # this at 127.0.0.1:53 makes honk ask dnsmasq while honk is also
        # intercepting dnsmasq's egress, and every uncached name ends in
        # SERVFAIL (verified on 6.12.112, beta.6). Change this if 223.5.5.5 is
        # unreachable on your network.
        local: 'udp://223.5.5.5:53'
    }
    routing {
        request {
            fallback: local
        }
        response {
            # `accept` returns the answer that `local` already produced.
            # Naming an upstream here re-queries it, and honk refuses a second
            # exchange to the same upstream: every name then fails with
            # "DNS response requery cycle" and the client sees SERVFAIL
            # (verified on 6.18.60, beta.6).
            fallback: accept
        }
    }
}

assets {
    # Downloads fetch directly: the proxy groups this dashboard will later
    # define must not be able to swallow the geodata files that the router
    # itself depends on to start.
    route: direct
    geodata {
        # doona reports "geodata update unavailable" until at least one asset
        # is actually loaded, and the rule below is what loads geosite.
        #
        # No URL is set on purpose. Naming one replaces honk's built-in list
        # instead of adding a mirror, and this network filters
        # raw.githubusercontent.com per IPv4 address (three of its four
        # addresses refuse the connection while the fourth works, and curl
        # retries across them while honk does not). The built-in list is
        # raw.githubusercontent.com first, fastly.jsdelivr.net second, and the
        # fallback is what makes the update succeed here.
        #
        # Updates land in <data_dir>/geosite.dat, which is earlier in honk's
        # search order than /usr/local/share/honk/; the init script's seed copy
        # there only guarantees an asset exists before the first download.
        auto_update: true
        cron: '0 3 * * *'
        checksum: true
    }
}

routing {
    # dnsmasq's own upstream queries leave through the WAN. Match them by
    # process name so a later proxy node cannot swallow the resolver that every
    # LAN client depends on.
    pname(dnsmasq) && l4proto(udp, tcp) && dport(53) -> direct(must)
    # honk resolves the geodata host with the same resolver path; exempt it too
    # or the download inherits whatever policy the proxy rules would apply.
    pname(honk-core) && l4proto(udp, tcp) && dport(53) -> direct(must)

    # Loading geosite is what makes the geodata asset live, which is the
    # precondition doona checks. The verdict equals the fallback below, so this
    # rule does not change where traffic goes.
    domain(geosite: cn) -> direct(must)

    # Everything else is direct until nodes and rules are added in doona. A
    # direct verdict returns the packet to the kernel, so NSS/ECM and the PPE
    # flowtable keep accelerating forwarded traffic exactly as before.
    fallback: direct
}

experimental {
    # No clash_api block: doona talks to the native API below, and the Clash
    # API would only serve a separate dashboard while costing a listener.
    native_api {
        enabled: true
        listen: '0.0.0.0:9527'
        password_auth: true
        config_write: true
        ui: 'embedded'
    }
    cache_file {
        enabled: true
    }
}
