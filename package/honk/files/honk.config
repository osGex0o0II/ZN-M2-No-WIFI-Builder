config honk 'config'
	option config_file '/etc/honk/config.dae'
	# 'db' keeps the configuration in a database in data_dir (honk-core --store db).
	# This image uses 'file' to keep the resident set small; doona still edits it.
	option store 'file'
	# Must equal global.data_dir of the configuration; sysupgrade keeps this directory.
	option data_dir '/etc/honk/data'
	# The eBPF verifier needs transient kernel memory to load honk's object. A
	# 256 MB board with the NSS driver resident cannot always provide it, and a
	# failed load ends in an OOM kill that leaks kernel memory. Refuse to start
	# below this many kB of MemAvailable instead; raise it if starts still die.
	option mem_min_kb '49152'
