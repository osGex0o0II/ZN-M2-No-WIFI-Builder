config honk 'config'
	option config_file '/etc/honk/config.dae'
	# 'db' keeps the administered configuration as revisions in
	# <data_dir>/state/honk.db (honk-core --store db). Doona needs it for
	# import and for the revision history, and the geodata settings need a
	# writable state database too. In this mode the database is authoritative:
	# config_file is imported once, when the database is empty, and later edits
	# to it are ignored. Change settings through Doona, or set this back to
	# 'file' to make config_file authoritative again.
	option store 'db'
	# Must equal global.data_dir of the configuration; sysupgrade keeps this directory.
	option data_dir '/etc/honk/data'
	# The eBPF verifier needs transient kernel memory to load honk's object. A
	# 256 MB board with the NSS driver resident cannot always provide it, and a
	# failed load ends in an OOM kill that leaks kernel memory. Refuse to start
	# below this many kB of MemAvailable instead; raise it if starts still die.
	option mem_min_kb '49152'
