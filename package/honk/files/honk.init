#!/bin/sh /etc/rc.common
#
# procd init script for honk-core.
#
# START/STOP must stay near the top: rpcd's rc list only reads them there.
USE_PROCD=1
START=99
STOP=01

CONF=honk
PROG=/usr/bin/honk-core
BPFFS=/sys/fs/bpf
# Geodata lands here rather than in the apk-managed /usr/share/v2ray tree.
# /usr/local/share/honk is the highest-priority location in honk's search order
# that no package owns, so an honk-side update never writes into a path that
# `apk upgrade` rewrites.
GEODATA_DIR=/usr/local/share/honk
GEODATA_SRC=/usr/share/v2ray/geosite.dat
# honk loads an embedded eBPF object and the verifier allocates transient kernel
# memory while it walks the program. On a 256 MB board that allocation can fail
# outright; the OOM killer then takes the process and, on this kernel, leaves
# the verifier's working set behind. Below this floor the load cannot finish, so
# refuse to start and say why instead of provoking an OOM kill.
MEM_MIN_KB_DEFAULT=49152

# OpenWrt calls enable for each init script during offline rootfs assembly.
# Keep the runtime rc.common enable command available to the administrator.
if [ -n "${IPKG_INSTROOT:-}" ]; then
	enable() { disable; }
fi

start_service() {
	config_load "$CONF"

	local config_file store data_dir mem_min
	config_get config_file config config_file /etc/honk/config.dae
	config_get store config store file
	config_get data_dir config data_dir /etc/honk/data
	config_get mem_min config mem_min_kb "$MEM_MIN_KB_DEFAULT"

	# dae creates the same dae0/daens pair and hooks the same interfaces.
	if ubus call service list '{"name":"dae"}' 2>/dev/null |
		jsonfilter -q -e '@.dae.instances[*].running' | grep -q true; then
		logger -t honk "dae is running; stop it before starting honk"
		return 1
	fi

	if [ ! -r "$config_file" ]; then
		logger -t honk "cannot read $config_file"
		return 1
	fi

	# honk loads an embedded eBPF object with CO-RE relocations. Without BTF
	# every load fails, so stop here with a message that names the build knob.
	if [ ! -e /sys/kernel/btf/vmlinux ] && [ ! -e /usr/lib/debug/boot/vmlinux ]; then
		logger -t honk "kernel has no BTF; rebuild it with CONFIG_KERNEL_DEBUG_INFO_BTF"
		return 1
	fi

	# aya pins maps under /sys/fs/bpf, which OpenWrt does not mount itself.
	# BusyBox has no mountpoint applet, so check /proc/mounts instead.
	if ! grep -qs ' /sys/fs/bpf bpf ' /proc/mounts &&
	   ! mount -t bpf bpf /sys/fs/bpf; then
		logger -t honk 'cannot mount bpffs'
		return 1
	fi

	seed_geodata

	if [ ! -r /sys/fs/cgroup/cgroup.controllers ]; then
		logger -t honk 'cgroup v2 is unavailable'
		return 1
	fi

	# A load that dies mid-verification leaves pinned maps behind, and a killed
	# process never runs its own cleanup. Start from an empty bpffs so each
	# attempt does not inherit the previous failure's kernel memory.
	clear_pins

	if ! mem_ok "$mem_min"; then
		logger -t honk \
			"$(mem_available)kB available, ${mem_min}kB required to load the eBPF object; not starting"
		return 1
	fi

	procd_open_instance "$CONF"
	procd_set_param command "$PROG" --config "$config_file"
	[ "$store" = db ] && procd_append_param command --store db --data-dir "$data_dir"
	# honk sizes its flow budget from RLIMIT_NOFILE.
	procd_set_param limits core="0" nofile="1048576 1048576"
	# A fatal exit is expected here: upstream issue #476 kills the process at
	# the end of a configuration reload. procd brings it back in a few seconds.
	# Cap the retries: on a board that cannot hold the verifier's working set
	# every respawn repeats the OOM kill and leaks about 430 kB each time, so an
	# unbounded loop drains the remaining memory. Five attempts cover a reload
	# crash; the watchdog still restarts a healthy-but-dead instance later.
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

clear_pins() {
	# honk pins its maps at the root of bpffs and is the only pin user on these
	# images (the init script mounts bpffs itself and refuses to run next to dae).
	# Only clear while honk is down: another process may own pins otherwise.
	[ -d "$BPFFS" ] || return 0
	pidof honk-core >/dev/null 2>&1 && return 0
	for pin in "$BPFFS"/*; do
		[ -f "$pin" ] || continue
		rm -f "$pin" 2>/dev/null
	done
	return 0
}

# honk resolves geodata to the first existing file in a fixed search order; the
# v2ray packages own /usr/share/v2ray and a later `apk upgrade` rewrites those
# files. Copy instead of symlinking so an honk-side geodata update cannot write
# back into an apk-managed path, and so the copy survives a package upgrade.
# geosite is small (about 2.4 MB) and is the asset routing actually loads;
# geoip stays in the package because nothing here matches on it.
seed_geodata() {
	local dir=$GEODATA_DIR src=$GEODATA_SRC
	mkdir -p "$dir" 2>/dev/null || return 0
	if [ ! -s "$dir/geosite.dat" ] && [ -s "$src" ]; then
		cp -f "$src" "$dir/geosite.dat" 2>/dev/null ||
			logger -t honk "cannot copy $src to $dir/geosite.dat"
	fi
	return 0
}


mem_available() {
	local avail
	avail="$(awk '/^MemAvailable:/ { print $2; exit }' /proc/meminfo 2>/dev/null)"
	case "$avail" in ''|*[!0-9]*) avail=0 ;; esac
	printf '%s\n' "$avail"
}

mem_ok() {
	local need avail
	need="${1:-$MEM_MIN_KB_DEFAULT}"
	case "$need" in ''|*[!0-9]*) need=$MEM_MIN_KB_DEFAULT ;; esac
	avail="$(mem_available)"
	[ "$avail" -ge "$need" ]
}

# procd respawns crash-looped instances; the pins of a killed process stay.
# rc.common calls service_stopped after a manual stop, so reclaim them there.
service_stopped() {
	clear_pins
}

reload_service() {
	config_load "$CONF"

	local config_file store data_dir want
	config_get config_file config config_file /etc/honk/config.dae
	config_get store config store file
	config_get data_dir config data_dir /etc/honk/data

	procd_running "$CONF" "$CONF" || return 0

	# --store and --data-dir are command-line flags, so SIGHUP cannot change
	# them. Compare the running command and fall back to a restart when they
	# differ from the UCI configuration.
	want="$PROG
--config
$config_file"
	[ "$store" = db ] && want="$want
--store
db
--data-dir
$data_dir"

	if [ "$(ubus call service list "{\"name\":\"$CONF\"}" 2>/dev/null |
		jsonfilter -q -e "@.$CONF.instances.$CONF.command[*]")" = "$want" ]; then
		# Reads the instance lock, so a stale instance is reported instead of
		# signalling an unrelated PID.
		"$PROG" reload
	else
		start
	fi
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
